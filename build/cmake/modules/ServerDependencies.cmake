# Presentation-free dependency set. SDL core supplies existing timing, threading,
# filesystem and in-memory surface APIs; all device/video/audio drivers are off.
if(WIN32)
  message(FATAL_ERROR "KFX_DEDICATED currently supports POSIX hosts")
endif()
find_package(Threads REQUIRED)
find_package(ZLIB REQUIRED)
include(FetchContent)
if(POLICY CMP0135)
 cmake_policy(SET CMP0135 NEW)
endif()
foreach(feature VIDEO AUDIO RENDER GPU CAMERA JOYSTICK HAPTIC SENSOR POWER DIALOG TRAY HIDAPI)
  set(SDL_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
FetchContent_Declare(kfx_server_sdl3 URL https://github.com/libsdl-org/SDL/releases/download/release-3.4.12/SDL3-3.4.12.tar.gz)
FetchContent_MakeAvailable(kfx_server_sdl3)
# Fetch only build-time source libraries; no original game assets or desktop SDKs.
FetchContent_Declare(kfx_server_json URL https://github.com/mity/centijson/archive/8c7a5fb.tar.gz)
FetchContent_Declare(kfx_server_enet URL https://github.com/SirLynix/enet6/archive/bf0003f.tar.gz)
FetchContent_Declare(kfx_server_astronomy_src URL https://github.com/cosinekitty/astronomy/archive/865d3da.tar.gz)
foreach(dep kfx_server_json kfx_server_astronomy_src kfx_server_enet)
 FetchContent_GetProperties(${dep})
 if(NOT ${dep}_POPULATED)
  FetchContent_Populate(${dep})
 endif()
endforeach()
add_subdirectory("${kfx_server_enet_SOURCE_DIR}" "server-enet-build" EXCLUDE_FROM_ALL)
add_library(json STATIC "${kfx_server_json_SOURCE_DIR}/src/json.c" "${kfx_server_json_SOURCE_DIR}/src/json-dom.c" "${kfx_server_json_SOURCE_DIR}/src/json-ptr.c" "${kfx_server_json_SOURCE_DIR}/src/value.c")
target_include_directories(json PUBLIC "${kfx_server_json_SOURCE_DIR}/src")
add_library(kfx_server_astronomy STATIC "${kfx_server_astronomy_src_SOURCE_DIR}/source/c/astronomy.c")
target_include_directories(kfx_server_astronomy PUBLIC "${kfx_server_astronomy_src_SOURCE_DIR}/source/c")
set(KFX_VENDOR_ROOT "${CMAKE_BINARY_DIR}/server-vendor")
file(MAKE_DIRECTORY "${KFX_VENDOR_ROOT}/centitoml")
if(NOT EXISTS "${KFX_VENDOR_ROOT}/centitoml/toml_api.c")
 file(DOWNLOAD "https://raw.githubusercontent.com/lurcheous73/keeperfx-macos/bb65dafd7d430a80fb22a426abf6a1c7354fb441/deps/centitoml/toml_api.c" "${KFX_VENDOR_ROOT}/centitoml/toml_api.c" EXPECTED_HASH SHA256=9dd61040a94bffebf3c35447993f711743979c058d34c60695c962fc29446997 TLS_VERIFY ON)
endif()
if(NOT EXISTS "${KFX_VENDOR_ROOT}/centitoml/toml.h")
 file(DOWNLOAD "https://raw.githubusercontent.com/lurcheous73/keeperfx-macos/bb65dafd7d430a80fb22a426abf6a1c7354fb441/deps/centitoml/toml.h" "${KFX_VENDOR_ROOT}/centitoml/toml.h" EXPECTED_HASH SHA256=40730628176c26f5723a1074ae402aa1cb458bf353a6e63515adbc3617de4e7b TLS_VERIFY ON)
endif()
if(NOT EXISTS "${KFX_VENDOR_ROOT}/centitoml/toml_conv.c")
 file(DOWNLOAD "https://raw.githubusercontent.com/lurcheous73/keeperfx-macos/bb65dafd7d430a80fb22a426abf6a1c7354fb441/deps/centitoml/toml_conv.c" "${KFX_VENDOR_ROOT}/centitoml/toml_conv.c" EXPECTED_HASH SHA256=100ef4c3980839e84675107eabbb40d8c5275d213ce777d5ead1a52a027a40c2 TLS_VERIFY ON)
endif()
add_library(centitoml OBJECT "${KFX_VENDOR_ROOT}/centitoml/toml_api.c")
target_include_directories(centitoml PUBLIC "${KFX_VENDOR_ROOT}/centitoml")
target_link_libraries(centitoml PUBLIC json)
# Custom animation PNG metadata is shared with clients and affects asset/animation
# setup. Preserve its parser until metadata is separated from visual pixel data.
set(SPNG_SHARED OFF CACHE BOOL "" FORCE)
set(SPNG_STATIC ON CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
FetchContent_Declare(kfx_server_spng URL https://github.com/randy408/libspng/archive/refs/tags/v0.7.4.tar.gz)
FetchContent_GetProperties(kfx_server_spng)
if(NOT kfx_server_spng_POPULATED)
 FetchContent_Populate(kfx_server_spng)
endif()
add_subdirectory("${kfx_server_spng_SOURCE_DIR}" "server-spng-build" EXCLUDE_FROM_ALL)
if(APPLE AND KFX_SERVER_TEST_DEPS)
 add_library(kfx_server_lua STATIC IMPORTED)
 set_target_properties(kfx_server_lua PROPERTIES IMPORTED_LOCATION "${KFX_SERVER_TEST_DEPS}/lua-fat/lib/liblua.a" INTERFACE_INCLUDE_DIRECTORIES "${KFX_SERVER_TEST_DEPS}/lua-fat/include")
 target_compile_definitions(kfx_server_lua INTERFACE lua_objlen=lua_rawlen luaL_checkint=luaL_checkinteger luaL_checklong=luaL_checkinteger)
 add_library(kfx_server_minizip STATIC IMPORTED)
 set_target_properties(kfx_server_minizip PROPERTIES IMPORTED_LOCATION "${KFX_SERVER_TEST_DEPS}/minizip-fat/lib/libminizip.a" INTERFACE_INCLUDE_DIRECTORIES "${KFX_SERVER_TEST_DEPS}/minizip-fat/include")
 add_library(kfx_server_curl STATIC IMPORTED)
 set_target_properties(kfx_server_curl PROPERTIES IMPORTED_LOCATION "${KFX_SERVER_TEST_DEPS}/curl-prefix/lib/libcurl.a" INTERFACE_INCLUDE_DIRECTORIES "${KFX_SERVER_TEST_DEPS}/curl-prefix/include")
 target_link_libraries(kfx_server_curl INTERFACE "${KFX_SERVER_TEST_DEPS}/openssl-fat/lib/libssl.a" "${KFX_SERVER_TEST_DEPS}/openssl-fat/lib/libcrypto.a" "-framework Security" "-framework CoreFoundation" "-framework SystemConfiguration" ZLIB::ZLIB)
else()
 find_package(PkgConfig REQUIRED)
 find_package(OpenSSL REQUIRED COMPONENTS Crypto)
 pkg_check_modules(SERVER_LUA REQUIRED IMPORTED_TARGET luajit)
 pkg_check_modules(SERVER_ZIP REQUIRED IMPORTED_TARGET minizip)
 pkg_check_modules(SERVER_CURL REQUIRED IMPORTED_TARGET libcurl)
 add_library(kfx_server_lua ALIAS PkgConfig::SERVER_LUA)
 add_library(kfx_server_minizip ALIAS PkgConfig::SERVER_ZIP)
 add_library(kfx_server_curl ALIAS PkgConfig::SERVER_CURL)
endif()
function(kfx_link_dependencies target)
 target_compile_definitions(${target} PRIVATE SPNG_STATIC=1)

 if(APPLE)
  target_link_libraries(${target} PRIVATE iconv)
 else()
  target_link_libraries(${target} PRIVATE OpenSSL::Crypto)
 endif()
 target_link_libraries(${target} PRIVATE SDL3::SDL3-static spng_static json enet6 kfx_server_astronomy centitoml kfx_server_lua kfx_server_minizip kfx_server_curl ZLIB::ZLIB Threads::Threads ${CMAKE_DL_LIBS})
endfunction()
